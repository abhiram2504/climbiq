# Database (used by the backend when run directly on the host)
DATABASE_URL=postgresql+psycopg://climbiq:climbiq@localhost:5432/climbiq

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=250
VIDEO_STORAGE_PATH=./data/videos
LOG_LEVEL=INFO

# PostgreSQL container
POSTGRES_DB=climbiq
POSTGRES_USER=climbiq
POSTGRES_PASSWORD=climbiq

# Frontend
VITE_API_URL=/api
