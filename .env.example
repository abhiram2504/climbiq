# Database (used by the backend when run directly on the host)
DATABASE_URL=postgresql+psycopg://climbiq:climbiq@localhost:5432/climbiq

# API
ENVIRONMENT=development
SERVICE_ROLE=api
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_SIZE_MB=250
MAX_VIDEO_DURATION_SECONDS=600
STORAGE_BACKEND=local
VIDEO_STORAGE_PATH=./data/videos
# Production object storage (Cloudflare R2 or another S3-compatible service)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_SECONDS=900
POSE_MODEL_PATH=./models/pose_landmarker_full.task
POSE_MODEL_VERSION=pose_landmarker_full_float16_v1
POSE_SAMPLING_FPS=8
POSE_DETECTION_CONFIDENCE=0.5
POSE_PRESENCE_CONFIDENCE=0.5
POSE_TRACKING_CONFIDENCE=0.5
POSE_DRAW_VISIBILITY=0.35
PROCESSING_MODE=local
PROCESSING_WORKERS=1
WORKER_POLL_SECONDS=2
WORKER_STALE_SECONDS=3600
WORKER_MAX_ATTEMPTS=3
FFMPEG_BINARY=ffmpeg
LOG_LEVEL=INFO

# Google login and optional read-only Gmail connection
# Create a Web application OAuth client and register this exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
AUTH_REQUIRED=false
AUTH_ALLOWED_EMAILS=
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=climbiq_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
OAUTH_FLOW_MINUTES=10

# PostgreSQL container
POSTGRES_DB=climbiq
POSTGRES_USER=climbiq
POSTGRES_PASSWORD=climbiq

# Frontend
VITE_API_URL=/api
